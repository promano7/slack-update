{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slack-update:candidate:event:1",
  "title": "CANDIDATE ONLY: prospective Slack-Update v1 single NDJSON event",
  "$comment": "Record shape only; framing, sequence and delivery are separate. Current emitter remains v0.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_status",
    "sequence",
    "timestamp",
    "operation",
    "type",
    "module",
    "action",
    "state",
    "message",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_status": {
      "const": "stable"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "check",
        "dry-run",
        "apply"
      ]
    },
    "type": {
      "enum": [
        "operation_started",
        "module_started",
        "module_completed",
        "action_started",
        "action_completed",
        "warning",
        "error",
        "operation_completed"
      ]
    },
    "module": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "operation_completed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "module": {
            "type": "null"
          },
          "action": {
            "type": "null"
          },
          "state": {
            "enum": [
              "success",
              "warning",
              "failed"
            ]
          }
        }
      }
    }
  ]
}
