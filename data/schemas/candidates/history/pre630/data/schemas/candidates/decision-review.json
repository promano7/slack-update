  "surface_scope": "Generated navigation to direct object declarations only; allOf/oneOf/$ref/if/then constraints remain in the complete unchanged bound schemas. Not a replacement specification or oracle.",
  "questions": [
    {
      "id": "J01",
      "topic": "Family and numeric version",
      "proposed_rule": "Select result/event/stream/fragment explicitly; numeric 1 or 1.0 with stable; reject bool, text, v0 and unknown versions without conversion.",
      "limit_or_risk": "Do not import the strict current Python oracle type identity as an undocumented lexical v1 integer requirement.",
      "required_review_or_future_evidence": "Explicit family/version/status positives and refusals, preserving current v0 evidence.",
      "disposition": "pending",
      "allowed_decisions": [
        "accept-as-written",
        "request-revision",
        "defer"
      ]
    },
    {
      "id": "J02",
      "topic": "Exact field sets and operation shapes",
      "proposed_rule": "Require all 17 result and 11 event fields; operation-specific check/dry-run/apply module shapes and exact build-option objects.",
      "limit_or_risk": "Adding or removing a field, changing type/null meaning or a closed enum needs a separately reviewed version; inspect every bound schema branch.",
      "required_review_or_future_evidence": "Full prospective independent expectations for every operation, required/missing/extra fields and cross-operation refusal.",
      "disposition": "pending",
      "allowed_decisions": [
        "accept-as-written",
        "request-revision",
        "defer"
      ]
    },
    {
      "id": "J03",
      "topic": "Final result projections",
      "proposed_rule": "Result codes 0-5 constrain operation, success, partial, boot_safe, reboot and English exit_code_meaning exactly as the bound result schema.",
      "limit_or_risk": "Reported success and boot_safe are data, not independent installed-state, recovery or boot-safety evidence.",
      "required_review_or_future_evidence": "Original aggregate oracles plus prospective complete objects; preserve code-to-meaning and reboot projections.",
      "disposition": "pending",
      "allowed_decisions": [
        "accept-as-written",
        "request-revision",
        "defer"
      ]
    },
    {
      "id": "J04",
      "topic": "Raw status and native criteria separation",
      "proposed_rule": "Raw codes and nullable statuses keep their separate domains. Native install20 requires empty AND no-effect; native upgrade20 is failure.",
      "limit_or_risk": "Current acceptance predicates admit 20 for install and upgrade; neither this dossier nor accepting a data shape endorses or repairs those predicates.",
      "required_review_or_future_evidence": "Separate case-specific consumer design must preserve the original raw20 rules and all original native criteria; no blanket metadata replacement.",
      "disposition": "pending",
      "allowed_decisions": [
        "accept-as-written",
        "request-revision",
        "defer"
      ]
    },
    {
      "id": "J05",
      "topic": "Types, nulls and counters",
      "proposed_rule": "Booleans are distinct from numbers; JSON Schema mathematical integers permit integral numeric spelling; null, zero, false, empty arrays and absence are distinct.",
      "limit_or_risk": "Do not coerce missing/null to zero or false; nonnegative counters and nullable action statuses differ from unrestricted raw event/check integers.",
      "required_review_or_future_evidence": "Independent boundary expectations for bool/int, null/not-run, empty/absent and each actual field constraint.",
      "disposition": "pending",
      "allowed_decisions": [
        "accept-as-written",
        "request-revision",
        "defer"
      ]
    },
    {
      "id": "J06",
