{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slack-update:candidate:event:1",
  "title": "CANDIDATE ONLY: prospective Slack-Update v1 single NDJSON event",
  "$comment": "Candidate record constraints including final code/state coherence; no runtime migration or native truth proof.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_status",
    "sequence",
    "timestamp",
    "operation",
    "type",
    "module",
    "action",
    "state",
    "message",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_status": {
      "const": "stable"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "check",
        "dry-run",
        "apply"
      ]
    },
    "type": {
      "enum": [
        "operation_started",
        "module_started",
        "module_completed",
        "action_started",
        "action_completed",
        "warning",
        "error",
        "operation_completed"
      ]
    },
    "module": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "operation_completed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "module": {
            "type": "null"
          },
          "action": {
            "type": "null"
          },
          "state": {
            "enum": [
              "success",
              "warning",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "operation_completed"
          },
          "exit_code": {
            "enum": [
              0,
              4,
              5
            ]
          }
        },
        "required": [
          "type",
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "success"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "operation_completed"
          },
          "exit_code": {
            "enum": [
              2
            ]
          }
        },
        "required": [
          "type",
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "warning"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "operation_completed"
          },
          "exit_code": {
            "enum": [
              1,
              3,
              6,
              7,
              8
            ]
          }
        },
        "required": [
          "type",
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      }
    }
  ]
}
